{
  "id": "wechat-native-isolated",
  "name": "WeChat (native Linux)",
  "description": "OpenClaw channel plugin for personal WeChat on Linux, via a local agent-wechat daemon: text, images, files, voice notes, stickers, groups and owner access commands.",
  "version": "0.1.0",
  "categories": [
    "channels"
  ],
  "channels": [
    "wechat-native-isolated"
  ],
  "channelConfigs": {
    "wechat-native-isolated": {
      "label": "WeChat",
      "description": "Personal WeChat through a local agent-wechat daemon on 127.0.0.1.",
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accounts": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "daemonAccountId",
                "selfId",
                "allowFrom",
                "startAfter",
                "baseUrl",
                "token",
                "journalDir"
              ],
              "properties": {
                "pacing": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "minDelayMs": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 60000
                    },
                    "maxDelayMs": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 60000
                    },
                    "perCharMs": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000
                    },
                    "dailyCap": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100000
                    }
                  }
                },
                "mediaMaxMb": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 64,
                  "default": 50
                },
                "mediaCaptionWindowMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 60000,
                  "default": 5000
                },
                "textMediaWindowMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 60000,
                  "default": 1500
                },
                "enabled": {
                  "const": true
                },
                "daemonAccountId": {
                  "type": "string",
                  "minLength": 1
                },
                "selfId": {
                  "type": "string",
                  "minLength": 1
                },
                "allowFrom": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "verifiedPeer": {
                  "type": "string",
                  "minLength": 1
                },
                "ownerIds": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "dmPolicy": {
                  "enum": [
                    "allowlist",
                    "disabled"
                  ]
                },
                "groupPolicy": {
                  "enum": [
                    "allowlist",
                    "disabled"
                  ]
                },
                "groups": {
                  "type": "object",
                  "propertyNames": {
                    "pattern": "@chatroom$"
                  },
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "requireMention": {
                        "const": true
                      }
                    }
                  }
                },
                "startAfter": {
                  "type": "string",
                  "minLength": 1
                },
                "baseUrl": {
                  "type": "string",
                  "pattern": "^http://127[.]0[.]0[.]1:[0-9]+/$"
                },
                "journalDir": {
                  "type": "string",
                  "minLength": 1
                },
                "token": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "source",
                        "provider",
                        "id"
                      ],
                      "properties": {
                        "source": {
                          "const": "env"
                        },
                        "provider": {
                          "const": "default"
                        },
                        "id": {
                          "type": "string",
                          "pattern": "^WX_NATIVE_ISOLATED_[A-Z0-9_]+$"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "source",
                        "provider",
                        "id"
                      ],
                      "properties": {
                        "source": {
                          "const": "file"
                        },
                        "provider": {
                          "const": "wechat-native-isolated"
                        },
                        "id": {
                          "const": "value"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  }
}
